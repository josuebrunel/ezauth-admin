package views

import (
	"time"

	"github.com/josuebrunel/ezauth/pkg/db/models"
)

// ImpersonationData is what the page shown during impersonation needs.
type ImpersonationData struct {
	User  *models.User // the impersonated user, who is signed in
	Admin string       // who is really signed in, as an email, or "an admin" if unknown
	Roles []string
	Now   time.Time
}

// ImpersonationPage is where an admin lands after choosing to impersonate
// someone. The panel is closed while impersonating, because the session user
// isn't an admin, so this shows that user's own profile and the way back.
templ ImpersonationPage(p Page, d ImpersonationData) {
	@LayoutBare(p, "Impersonating "+displayName(d.User)) {
		<div role="status" class="bg-warning text-warning-content px-4 py-3">
			<div class="flex flex-wrap items-center justify-between gap-3 max-w-3xl mx-auto">
				<p class="font-medium">
					You're signed in as <strong>{ displayName(d.User) }</strong>. You're really { d.Admin }.
				</p>
				<form method="post" action={ p.URL("/impersonate/stop") }>
					<button type="submit" class="btn btn-sm btn-neutral">Stop impersonating</button>
				</form>
			</div>
		</div>
		<main class="px-4 py-8 md:py-12 max-w-3xl mx-auto w-full">
			<article class="surface p-5 md:p-6">
				<div class="flex items-center gap-4">
					<div class="avatar-initials size-16 text-xl" aria-hidden="true">{ userInitials(d.User) }</div>
					<div class="min-w-0">
						<h1 class="text-2xl font-bold truncate">{ displayName(d.User) }</h1>
						<p class="muted truncate">{ d.User.Email }</p>
						<div class="flex flex-wrap gap-2 mt-2">
							@statusChips(d.User, d.Now)
						</div>
					</div>
				</div>
				<dl class="grid sm:grid-cols-2 gap-x-6 gap-y-4 mt-6">
					@field("Joined", fmtDate(d.User.CreatedAt))
					@field("Last sign-in", fmtTimePtr(d.User.LastLoginAt))
					@field("Last active", relTime(d.User.LastActiveAt, d.Now))
					@field("Sign-in method", d.User.Provider)
					<div class="sm:col-span-2">
						<dt class="text-xs font-semibold uppercase tracking-wide muted">Roles</dt>
						<dd class="mt-1 flex flex-wrap gap-2">
							if len(d.Roles) == 0 {
								<span class="muted">None</span>
							}
							for _, r := range d.Roles {
								<span class="chip chip-role">{ r }</span>
							}
						</dd>
					</div>
				</dl>
			</article>
			<p class="muted text-sm mt-6">
				This is { displayName(d.User) }'s own account. The admin panel is closed while you're impersonating, because { displayName(d.User) } isn't an admin. Stop impersonating to get back to it.
			</p>
			<form method="post" action={ p.URL("/impersonate/stop") } class="mt-4">
				<button type="submit" class="btn btn-primary">Stop impersonating</button>
			</form>
		</main>
	}
}
