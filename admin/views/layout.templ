package views

import "github.com/josuebrunel/ezauth/pkg/db/models"

// Page carries the data every full page needs.
type Page struct {
	AppName  string
	BasePath string
	User     *models.User
	// Active is the nav key of the current section ("dashboard", "users").
	Active string
	Crumbs []Crumb
	// Notice is a one-off message carried over a redirect ("Profile saved.").
	Notice string
	// Boosted is set when an hx-boost navigation asked for this page: the
	// layout then answers with the content only, and the shell stays put.
	Boosted bool
	// Scripts are extra scripts for this page, as paths under the panel's
	// base path (the dashboard loads Chart.js this way).
	Scripts []string
}

// URL returns path (starting with "/") under the panel's base path.
func (p Page) URL(path string) templ.SafeURL {
	return templ.URL(p.BasePath + path)
}

// Path is URL as a plain string, for attributes like hx-get.
func (p Page) Path(path string) string {
	return p.BasePath + path
}

type navItem struct {
	Key   string
	Label string
	Path  string
}

// navItems lists the sections in the sidebar.
func navItems() []navItem {
	return []navItem{
		{Key: "dashboard", Label: "Dashboard", Path: "/"},
		{Key: "users", Label: "Users", Path: "/users"},
		{Key: "invitations", Label: "Invitations", Path: "/invitations"},
		{Key: "roles", Label: "Roles", Path: "/roles"},
		{Key: "permissions", Label: "Permissions", Path: "/permissions"},
		{Key: "audit", Label: "Audit log", Path: "/audit"},
	}
}

templ head(p Page, title string) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<meta name="robots" content="noindex, nofollow"/>
		<title>{ title } · { p.AppName } Admin</title>
		<meta name="description" content={ "Admin panel for " + p.AppName }/>
		<link rel="stylesheet" href={ p.Path("/static/admin.css") }/>
		<script src={ p.Path("/static/admin.js") }></script>
		<script src={ p.Path("/static/htmx.min.js") } defer></script>
		for _, src := range p.Scripts {
			<script src={ p.Path(src) } defer></script>
		}
	</head>
}

templ icon(key string) {
	switch key {
		case "dashboard":
			@iconDashboard()
		case "users":
			@iconUsers()
		case "invitations":
			@iconMail()
		case "roles":
			@iconRoles()
		case "permissions":
			@iconLock()
		case "audit":
			@iconList()
	}
}

// mainNav is the sidebar menu. As an out-of-band fragment it refreshes the
// highlighted section after a boosted navigation.
templ mainNav(p Page, oob bool) {
	<nav
		id="main-nav"
		aria-label="Main"
		class="mt-4 space-y-1"
		if oob {
			hx-swap-oob="true"
		}
	>
		for _, item := range navItems() {
			<a
				class="nav-link"
				href={ p.URL(item.Path) }
				if item.Key == "dashboard" {
					hx-boost="false"
				}
				if item.Key == p.Active {
					aria-current="page"
				}
			>
				@icon(item.Key)
				{ item.Label }
			</a>
		}
	</nav>
}

templ sidebar(p Page) {
	<aside class="min-h-full w-72 bg-base-200 border-r border-base-300 p-4 flex flex-col">
		<a href={ p.URL("/") } hx-boost="false" class="flex items-center gap-3 px-2 py-3">
			<span class="size-9 rounded-xl bg-primary text-primary-content grid place-items-center">
				@iconShield()
			</span>
			<span class="leading-tight">
				<span class="block font-display font-semibold text-lg">{ p.AppName }</span>
				<span class="block text-xs muted">Admin</span>
			</span>
		</a>
		@mainNav(p, false)
		if p.User != nil {
			<p class="mt-auto text-xs muted px-2 pt-6">
				Signed in as
				<br/>
				<strong class="text-base-content break-all">{ p.User.Email }</strong>
			</p>
		}
	</aside>
}

templ breadcrumbs(p Page, oob bool) {
	<nav
		id="breadcrumbs"
		aria-label="Breadcrumb"
		class="flex-1 min-w-0"
		if oob {
			hx-swap-oob="true"
		}
	>
		<ol class="flex items-center gap-2 text-sm muted">
			for i, c := range p.Crumbs {
				if i > 0 {
					<li class="hidden sm:block" aria-hidden="true">/</li>
				}
				if c.Href != "" {
					<li class="hidden sm:block"><a class="link" href={ p.URL(c.Href) } if c.Href == "/" {
						hx-boost="false"
					}>{ c.Label }</a></li>
				} else {
					<li class="text-base-content font-medium truncate" aria-current="page">{ c.Label }</li>
				}
			}
		</ol>
	</nav>
}

templ topbar(p Page) {
	<header class="glass-bar sticky top-0 z-30">
		<div class="flex items-center gap-3 px-4 h-16 max-w-6xl mx-auto w-full">
			<label for="nav-drawer" class="btn btn-ghost btn-square lg:hidden" aria-label="Open navigation">
				@iconMenu()
			</label>
			@breadcrumbs(p, false)
			<button class="btn btn-ghost btn-square" data-theme-toggle aria-label="Dark theme" aria-pressed="false">
				@iconMoon()
				@iconSun()
			</button>
			if p.User != nil {
				<div class="avatar-initials size-9 text-sm" title={ displayName(p.User) } role="img" aria-label={ "Signed in as " + displayName(p.User) }>
					{ userInitials(p.User) }
				</div>
			}
		</div>
	</header>
}

// Layout is the shared shell: head, sidebar, top bar, content slot and the
// toast region that HTMX responses swap messages into.
templ Layout(p Page, title string) {
	if p.Boosted {
		@boostedContent(p, title) {
			{ children... }
		}
	} else {
		@fullLayout(p, title) {
			{ children... }
		}
	}
}

// boostedContent answers an hx-boost navigation: the new title, the
// breadcrumbs and menu as out-of-band swaps, and the page content for #main.
templ boostedContent(p Page, title string) {
	<title>{ title } · { p.AppName } Admin</title>
	@breadcrumbs(p, true)
	@mainNav(p, true)
	@mainBody(p) {
		{ children... }
	}
}

templ mainBody(p Page) {
	if p.Notice != "" {
		<div role="status" class="alert alert-success mb-4">{ p.Notice }</div>
	}
	{ children... }
}

templ fullLayout(p Page, title string) {
	<!DOCTYPE html>
	<html lang="en">
		@head(p, title)
		<body hx-boost="true" hx-target="#main" hx-swap="innerHTML transition:true show:window:top">
			<div class="mesh" aria-hidden="true"></div>
			<a href="#main" class="btn btn-primary absolute -top-20 left-2 focus:top-2 z-50">Skip to content</a>
			<div class="drawer lg:drawer-open">
				<input id="nav-drawer" type="checkbox" class="drawer-toggle" aria-label="Toggle navigation"/>
				<div class="drawer-content flex flex-col min-w-0">
					@topbar(p)
					<main id="main" class="px-4 py-6 md:py-10 max-w-6xl mx-auto w-full">
						@mainBody(p) {
							{ children... }
						}
					</main>
				</div>
				<div class="drawer-side z-40">
					<label for="nav-drawer" aria-label="Close navigation" class="drawer-overlay"></label>
					@sidebar(p)
				</div>
			</div>
			<div id="toasts" class="toast toast-end z-50" role="status" aria-live="polite"></div>
		</body>
	</html>
}

// LayoutBare is the shell without the sidebar and top bar. It is for pages
// shown while the panel itself is closed to the session, where every link in
// the navigation would lead nowhere.
templ LayoutBare(p Page, title string) {
	<!DOCTYPE html>
	<html lang="en">
		@head(p, title)
		<body>
			<div class="mesh" aria-hidden="true"></div>
			{ children... }
		</body>
	</html>
}

// Toast is an out-of-band fragment: HTMX appends it to #toasts, whatever the
// request's own target was, and it removes itself after a few seconds.
templ Toast(kind string, message string) {
	<div id="toasts" hx-swap-oob="beforeend">
		<div
			class={ "alert shadow-lg", templ.KV("alert-error", kind == "error"), templ.KV("bg-neutral text-neutral-content", kind != "error") }
			hx-on::load="setTimeout(() => this.remove(), 4000)"
		>
			<span>{ message }</span>
		</div>
	</div>
}
