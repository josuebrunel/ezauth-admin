package views

templ Dashboard(p Page) {
	@Layout(p, "Dashboard") {
		<h1 class="text-2xl md:text-3xl font-bold">Welcome back</h1>
		<p class="mt-2 muted">You're signed in to the { p.AppName } admin panel.</p>
		<p class="mt-6">
			<a href={ p.URL("/users") } class="btn btn-primary">Browse users</a>
		</p>
	}
}
