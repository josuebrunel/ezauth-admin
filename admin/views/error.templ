package views

import "strconv"

templ ErrorPage(p Page, code int, message string) {
	@Layout(p, "Error "+strconv.Itoa(code)) {
		<div class="surface p-6 max-w-xl">
			<h1 class="text-xl font-bold">Error { strconv.Itoa(code) }</h1>
			<p class="mt-2">{ message }</p>
			<a href={ p.URL("/") } class="btn btn-primary mt-4">Back to dashboard</a>
		</div>
	}
}
