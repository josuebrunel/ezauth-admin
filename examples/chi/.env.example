# Optional. The example runs with no configuration (SQLite, throwaway
# demo secrets). Set these to override the defaults.
APP_ADDR=:8080
APP_ADMIN_EMAIL=admin@example.com
# Optional. Without it, a random password is logged once on first start.
APP_ADMIN_PASSWORD=demo-admin-password
# Optional. The same, for alice, bob, carol and dave.
APP_DEMO_PASSWORD=demo-user-password

EZAUTH_API_KEY=change-me-api-key
# At least 32 characters.
EZAUTH_JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
# sqlite (default) | postgres | mysql
EZAUTH_DB_DIALECT=sqlite
EZAUTH_DB_DSN=file:data/ezauth.db
